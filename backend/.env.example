NODE_ENV=development
PORT=4000

# CORS
CLIENT_ORIGIN=http://localhost:3000

# MySQL (Laragon defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=publisherhouse

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Public writer accounts
SUBSCRIBER_JWT_SECRET=change-me-to-a-different-long-random-string
SUBSCRIBER_JWT_EXPIRES_IN=30d

# URLs used to build TAP redirect/webhook links
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# TAP Payments (https://www.tap.company) - use a TEST secret key for now
TAP_SECRET_KEY=replace-with-your-tap-test-secret-key
TAP_BASE_URL=https://api.tap.company/v2

# PayPal (https://developer.paypal.com) - create a free sandbox app to get
# a Client ID/Secret, then paste them here. Leave blank to keep PayPal
# disabled as a payment option.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# - free forever, no credit card needed. The value below is Cloudflare's
# PUBLIC, DOCUMENTED "always passes" dummy test secret - fine for testing
# the wiring, but it provides NO real bot protection. Replace with your own
# widget's Secret Key before production. Leave blank to disable the CAPTCHA.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
