NODE_ENV=development
PORT=4000

# CORS
CLIENT_ORIGIN=http://localhost:3000

# MySQL (Laragon defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=publisherhouse

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Public writer accounts
SUBSCRIBER_JWT_SECRET=change-me-to-a-different-long-random-string
SUBSCRIBER_JWT_EXPIRES_IN=30d

# URLs used to build TAP redirect/webhook links
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# TAP Payments (https://www.tap.company) - use a TEST secret key for now
TAP_SECRET_KEY=replace-with-your-tap-test-secret-key
TAP_BASE_URL=https://api.tap.company/v2
